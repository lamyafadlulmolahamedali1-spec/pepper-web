        p.createMultiBody(0,-1,vs,[2.9+random.uniform(-.12,.12),2.6+random.uniform(-.12,.12),2.15+i*0.07])
    cyl([-2.9,2.7,0.55],0.02,1.10,GOLD)
    cyl([-2.9,2.7,1.20],0.16,0.24,[1,0.95,0.80,0.9])

    # ---- balloons ----
    cols=[[0.95,0.35,0.45,1],[0.35,0.65,0.95,1],[0.45,0.90,0.60,1],
          [0.98,0.85,0.35,1],[0.85,0.45,0.95,1],[1,0.62,0.30,1]]
    globals()["_balloons"]=[]
    for i in range(7):
        x=random.uniform(-2.0,2.0); y=random.uniform(-1.0,2.0); z=random.uniform(1.1,1.7)
        vs=p.createVisualShape(p.GEOM_SPHERE,radius=0.14,rgbaColor=cols[i%len(cols)])
        cs=p.createCollisionShape(p.GEOM_SPHERE,radius=0.14)
        bid=p.createMultiBody(0.02,cs,vs,[x,y,z])   # light physical balloon
        p.changeDynamics(bid,-1,linearDamping=2.2,angularDamping=2.2,restitution=0.8)
        _balloons.append({"id":bid,"x":x,"y":y,"z":z,
                          "vx":random.uniform(-.006,.006),"vy":random.uniform(-.006,.006),
                          "ph":random.uniform(0,6.3)})

def _float_balloons(p,t):
    """Balloons drift around the room."""
    import math
    for b in globals().get("_balloons",[]):
        try:
            pos,_=p.getBasePositionAndOrientation(b["id"])
            # buoyancy keeps it near target height, gentle drift, walls bounce
            fz=(b["z"]-pos[2])*0.30 + 0.02*math.sin(t*0.7+b["ph"])
            fx=b["vx"]*3 - (0.25 if pos[0]>2.4 else 0) + (0.25 if pos[0]<-2.4 else 0)
            fy=b["vy"]*3 - (0.25 if pos[1]>2.7 else 0) + (0.25 if pos[1]<-1.3 else 0)
            p.applyExternalForce(b["id"],-1,[fx,fy,fz+0.196],pos,p.WORLD_FRAME)
        except Exception: pass

def _screen_focus():
    """Look at the wall screen (session monitoring)."""
    if _pepper is None: return
    try:
        _pepper.setAngles(["HeadYaw","HeadPitch"],[0.0,-0.12],0.15)
    except Exception: pass

_speaking=False
_sm={"yaw":0.0,"pitch":0.0,"rs":1.4,"ls":1.4,"re":0.5,"le":-0.5}

def set_speaking(flag):
    global _speaking; _speaking=bool(flag)

def _lerp(a,b,f): return a+(b-a)*f

def hello_wave():
    """Big friendly wave at simulation start."""
    if _pepper is None: return
    def _h():
        try:
            time.sleep(1.0)
            _pepper.setAngles(["HeadYaw","HeadPitch"],[0.0,-0.1],0.6)
            for _ in range(4):
                _pepper.setAngles(["RShoulderPitch","RShoulderRoll","RElbowRoll"],
                                  [-1.35,-0.35,1.10],0.95); time.sleep(0.26)
                _pepper.setAngles(["RShoulderPitch","RShoulderRoll","RElbowRoll"],
                                  [-1.35,-0.95,0.45],0.95); time.sleep(0.26)
            _pepper.setAngles(["RShoulderPitch","RShoulderRoll","RElbowRoll"],
                              [1.4,-0.15,0.5],0.7)
        except Exception: pass
    threading.Thread(target=_h,daemon=True).start()

def _chase_balloon(t):
    """Lively, human-like motion. Faster and wider while speaking."""
    import math
    if _pepper is None: return
    bs=globals().get("_balloons",[])
    if not bs: return
    # pick the NEAREST balloon so he really follows movement
    try:
        import pybullet as _pb
        _rx,_ry,_=_pepper.getPosition()
        b=min(bs,key=lambda bb:(lambda q:(q[0]-_rx)**2+(q[1]-_ry)**2)(
            _pb.getBasePositionAndOrientation(bb["id"])[0]))
    except Exception:
        b=bs[int(t*0.10)%len(bs)]
    try:
        import pybullet as p
        pos,_=p.getBasePositionAndOrientation(b["id"])
        rx,ry,_th=_pepper.getPosition()
        if math.hypot(rx,ry)>0.20:
            _pepper.moveTo(0,0,0,frame=1,speed=0.4,_async=False); return

        dx,dy=pos[0]-rx,pos[1]-ry
        tgt_yaw=max(-1.6,min(1.6,math.atan2(dx,max(0.4,dy))))
        tgt_pitch=max(-0.45,min(0.35,-(pos[2]-1.25)*0.45))

        amp  = 0.75 if _speaking else 0.32
        blend= 0.42 if _speaking else 0.28      # much faster response
        ph   = t*(6.5 if _speaking else 2.8)    # faster rhythm

        _sm["yaw"]  =_lerp(_sm["yaw"],  tgt_yaw, 0.45)
        _sm["pitch"]=_lerp(_sm["pitch"],tgt_pitch, 0.45)
        _sm["rs"]=_lerp(_sm["rs"], 1.00-amp*abs(math.sin(ph)),      blend)
        _sm["ls"]=_lerp(_sm["ls"], 1.00-amp*abs(math.cos(ph*0.9)),  blend)
        _sm["re"]=_lerp(_sm["re"], 0.40+amp*0.75*math.sin(ph*1.4),  blend)
        _sm["le"]=_lerp(_sm["le"],-0.40-amp*0.75*math.cos(ph*1.4),  blend)

        _pepper.setAngles(["HeadYaw","HeadPitch"],[_sm["yaw"],_sm["pitch"]],0.85)
        _pepper.setAngles(["RShoulderPitch","LShoulderPitch","RElbowRoll","LElbowRoll"],
                          [_sm["rs"],_sm["ls"],_sm["re"],_sm["le"]],0.60)
    except Exception: pass

def _track_balloon(t):
    """Pepper looks at the nearest balloon and reaches toward it."""
    import math
    if _pepper is None: return
    bs=globals().get("_balloons",[])
    if not bs: return
    b=bs[int(t*0.25)%len(bs)]
    try:
        yaw=max(-2.0,min(2.0,math.atan2(b["x"],max(0.3,b["y"]))))
        pitch=max(-0.6,min(0.4,-(b["z"]-1.2)*0.5))
        _pepper.setAngles(["HeadYaw","HeadPitch"],[yaw,pitch],0.25)
        if int(t)%7<3:
            side="R" if b["x"]>0 else "L"
            _pepper.setAngles([side+"ShoulderPitch",side+"ShoulderRoll"],
                              [-0.5,-0.3 if side=="R" else 0.3],0.3)
        else:
            _pepper.setAngles(["RShoulderPitch","LShoulderPitch"],[1.4,1.4],0.2)
    except Exception: pass

def run_pepper_sim():
    global _pepper,_sm
    try:
        from qibullet import SimulationManager
        _sm=SimulationManager()
        client=_sm.launchSimulation(gui=True)
        _pepper=_sm.spawnPepper(client, spawn_ground_plane=True)
        try:
            import pybullet as _p
            _build_room(_p)
        except Exception as e: print("[pepper] room error:", e)
        try: _pepper.goToPosture("Stand", 0.6)
        except Exception: pass
        print("[pepper] simulation ready")
        hello_wave()
        hello_wave()
        t=0.0
        while True:
            # gentle idle: subtle head + arm motion so he looks alive
            try:
                _chase_balloon(t)
            except Exception:
                pass
            try:
                import pybullet as _p
                _float_balloons(_p, t)
            except Exception: pass
            t+=0.05
            time.sleep(0.05)
    except Exception as e:
        print("[pepper] sim error:", e)

def wave():
    """Pepper waves — call on greeting / correct answer."""
    if _pepper is None: return
    def _w():
        try:
            for _ in range(3):
                _pepper.setAngles(["RShoulderPitch","RShoulderRoll","RElbowRoll"],
                                  [-0.6,-0.3,1.2],0.4); time.sleep(0.35)
                _pepper.setAngles(["RShoulderPitch","RShoulderRoll","RElbowRoll"],
