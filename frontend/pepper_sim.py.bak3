© 2026 Lamya Fadlulmola Hamed Ali"""
import time, threading, math

_pepper=None
_sm=None

def _build_room(p):
    """Modern luxury therapy room."""
    import random
    def box(pos,size,col,mass=0):
        vs=p.createVisualShape(p.GEOM_BOX,halfExtents=size,rgbaColor=col)
        cs=p.createCollisionShape(p.GEOM_BOX,halfExtents=size)
        return p.createMultiBody(mass,cs,vs,pos)
    def cyl(pos,r,h,col):
        vs=p.createVisualShape(p.GEOM_CYLINDER,radius=r,length=h,rgbaColor=col)
        return p.createMultiBody(0,-1,vs,pos)

    CREAM=[0.96,0.94,0.90,1]; CHARCOAL=[0.22,0.24,0.28,1]
    GOLD=[0.83,0.69,0.35,1]; WOOD=[0.42,0.28,0.18,1]; RUG=[0.85,0.80,0.88,1]

    # walls (physical — Pepper cannot pass through)
    box([0,3.2,1.4],[3.2,0.12,1.4],CREAM)
    box([-3.2,0,1.4],[0.12,3.2,1.4],CREAM)
    box([3.2,0,1.4],[0.12,3.2,1.4],CREAM)
    box([0,-3.2,1.4],[3.2,0.12,1.4],CREAM)      # fourth wall (closed room)
    # gold trim
    box([0,3.08,0.12],[3.2,0.03,0.12],GOLD)

    # large area rug
    box([0,0.6,0.008],[2.2,1.6,0.008],RUG)

    # ---- WALL SCREEN: Pepper Clinical System UI mirror ----
    box([0,3.10,1.55],[1.35,0.04,0.82],[0.04,0.05,0.09,1])       # bezel
    box([0,3.05,1.55],[1.29,0.02,0.76],[0.05,0.07,0.13,1])       # dark UI bg
    box([0,3.03,2.20],[1.20,0.01,0.09],[0.48,0.23,0.85,1])       # purple header
    globals()["_ui"]={}
    # left panel = camera feed
    box([-0.80,3.02,1.60],[0.42,0.01,0.42],[0.10,0.14,0.22,1])
    vs=p.createVisualShape(p.GEOM_SPHERE,radius=0.10,rgbaColor=[0.85,0.70,0.60,1])
    _ui["face"]=p.createMultiBody(0,-1,vs,[-0.80,3.00,1.68])
    # centre = 2x2 task grid
    for i,(cx,cz) in enumerate([(-0.13,1.80),(0.30,1.80),(-0.13,1.40),(0.30,1.40)]):
        c=[[0.95,0.35,0.35,1],[0.35,0.75,0.95,1],[0.45,0.90,0.55,1],[0.98,0.85,0.35,1]][i]
        _ui[f"tile{i}"]=box([cx,3.02,cz],[0.19,0.01,0.17],c)
    # right = stats column
    for k,(cz,c) in enumerate([(1.90,[0.30,0.85,0.55,1]),(1.62,[0.98,0.80,0.30,1]),
                                (1.34,[0.55,0.60,0.95,1])]):
        box([0.92,3.02,cz],[0.28,0.01,0.10],c)
    # progress bar
    box([0,3.02,1.00],[1.15,0.01,0.055],[0.15,0.18,0.26,1])
    _ui["prog"]=box([-0.60,3.01,1.00],[0.45,0.01,0.045],[0.30,0.90,0.55,1])

    # ---- wall banner: title + supportive message ----
    box([0,3.09,2.55],[1.55,0.02,0.16],[0.48,0.23,0.85,1])       # purple banner
    box([0,3.06,2.55],[1.50,0.01,0.13],[1,1,1,1])                # white plate
    globals()["_wall_text"]=True
    try:
        p.addUserDebugText("PEPPER CLINICAL INFINITY  V6",[0,3.05,2.57],
                           textColorRGB=[0.30,0.10,0.60],textSize=1.6)
        p.addUserDebugText("Every child learns in their own beautiful way",
                           [0,3.05,2.40],textColorRGB=[0.20,0.35,0.55],textSize=1.0)
        p.addUserDebugText("Autism Therapy Room  -  You are safe here",
                           [0,3.05,0.55],textColorRGB=[0.30,0.45,0.35],textSize=1.0)
    except Exception: pass

    # ---- wall doodles (child-friendly shapes) ----
    for dx,dz,c,r in [(-1.15,2.05,[0.98,0.80,0.25,1],0.10),(1.15,2.05,[0.35,0.75,0.95,1],0.09),
                      (-0.75,0.95,[0.45,0.90,0.55,1],0.07),(0.75,0.95,[0.95,0.45,0.55,1],0.07)]:
        vs=p.createVisualShape(p.GEOM_SPHERE,radius=r,rgbaColor=c)
        p.createMultiBody(0,-1,vs,[dx,3.13,dz])
    for dx,dz in [(-1.55,1.35),(1.55,1.35)]:
        box([dx,3.13,dz],[0.05,0.01,0.05],[0.85,0.55,0.90,1])

    # ---- 5 sofas / seating ----
    def sofa(sx,sy,col,rot=0):
        w=0.95 if rot==0 else 0.42
        d=0.42 if rot==0 else 0.95
        box([sx,sy,0.30],[w,d,0.14],col)
        if rot==0: box([sx,sy+0.36,0.55],[w,0.09,0.28],col)
        else:      box([sx+0.36,sy,0.55],[0.09,d,0.28],col)
        for lx,ly in [(-w*0.85,-d*0.75),(w*0.85,-d*0.75),(-w*0.85,d*0.75),(w*0.85,d*0.75)]:
            cyl([sx+lx,sy+ly,0.08],0.032,0.16,GOLD)
        for cx in ([-0.5,0,0.5] if rot==0 else [0]):
            if rot==0: box([sx+cx,sy+0.05,0.47],[0.22,0.30,0.05],[col[0]*1.3,col[1]*1.3,col[2]*1.3,1])

    CH=[0.22,0.24,0.28,1]; NAVY=[0.18,0.24,0.38,1]; TAUPE=[0.42,0.38,0.36,1]
    sofa(-1.6,2.5,CH)           # 1 faces room faces room
    sofa( 1.6,2.5,NAVY)         # 2
    sofa(-2.6,0.6,TAUPE,rot=1)  # 3
    sofa( 2.6,0.6,CH,rot=1)     # 4
    sofa( 0.0,-1.4,NAVY)        # 5

    # ---- coffee table ----
    tx,ty=0,0.9
    box([tx,ty,0.40],[0.60,0.35,0.025],WOOD)
    for lx,ly in [(-0.52,-0.27),(0.52,-0.27),(-0.52,0.27),(0.52,0.27)]:
        cyl([tx+lx,ty+ly,0.20],0.028,0.40,GOLD)
    cyl([tx-0.25,ty,0.46],0.06,0.10,[0.75,0.85,0.95,0.85])
    box([tx+0.20,ty,0.435],[0.13,0.09,0.012],[0.55,0.20,0.22,1])

    # ---- uploaded ASD images (full size, spread across walls) ----
    import os as _os
    _here=_os.path.dirname(_os.path.abspath(__file__))
    def wall_img(fn,pos,hw,hh,axis="y"):
        path=_os.path.join(_here,fn)
        if axis=="y":
            fr=[hw+0.05,0.02,hh+0.05]; ip=[pos[0],pos[1]+0.03,pos[2]]
            vh=[hw,0.012,hh]
        else:
            fr=[0.02,hw+0.05,hh+0.05]; ip=[pos[0]+0.03,pos[1],pos[2]]
            vh=[0.012,hw,hh]
        box([pos[0],pos[1]+ (0.03 if axis=="y" else 0),pos[2]] if axis=="y" else
            [pos[0]+0.03,pos[1],pos[2]], fr, GOLD)
        if _os.path.exists(path):
            try:
                tex=p.loadTexture(path)
                vs=p.createVisualShape(p.GEOM_BOX,halfExtents=vh,rgbaColor=[1,1,1,1])
                bid=p.createMultiBody(0,-1,vs,ip)
                p.changeVisualShape(bid,-1,textureUniqueId=tex)
                print("[room] IMAGE OK:",fn); return
            except Exception as e: print("[room] tex fail",fn,e)
        else: print("[room] NOT FOUND:",path)
        box(ip,vh,[1,1,1,1])

    # back wall (beside the screen) — full square images
    wall_img("autism.jpeg",  [-2.30,3.05,1.60], 0.62,0.62)
    wall_img("images.jpeg",  [ 2.30,3.05,1.60], 0.62,0.62)
    # LEFT wall — using the empty space
    wall_img("images1.jpeg", [-3.10,1.20,1.55], 0.70,0.45, axis="x")

    # ---- BIG system name板 on the back wall (inside room) ----
    box([0,3.06,2.45],[2.20,0.02,0.26],[0.48,0.23,0.85,1])
    box([0,3.03,2.45],[2.14,0.01,0.21],[1,1,1,1])
    try:
        p.addUserDebugText("PEPPER  CLINICAL  INFINITY  V6",[0,2.98,2.45],
                           textColorRGB=[0.35,0.08,0.68],textSize=2.6)
        p.addUserDebugText("AI-Assisted Autism Therapy Room",[0,2.98,2.20],
                           textColorRGB=[0.22,0.42,0.62],textSize=1.3)
        p.addUserDebugText("You are amazing exactly as you are",[-2.30,2.98,0.85],
                           textColorRGB=[0.55,0.20,0.45],textSize=1.0)
        p.addUserDebugText("Every small step is a big victory",[2.30,2.98,0.85],
                           textColorRGB=[0.20,0.45,0.60],textSize=1.0)
        p.addUserDebugText("Patience   Play   Progress",[0,2.98,0.62],
                           textColorRGB=[0.30,0.45,0.35],textSize=1.2)
    except Exception as e: print("[room] text:",e)

    # ---- decoration: pendant lights ----
    for lx in (-1.2,1.2):
        cyl([lx,1.5,2.35],0.01,0.50,[0.3,0.3,0.3,1])
        vs=p.createVisualShape(p.GEOM_SPHERE,radius=0.11,rgbaColor=[1,0.95,0.75,0.9])
        p.createMultiBody(0,-1,vs,[lx,1.5,2.05])

    # ---- shelf + plant + lamp ----
    box([2.9,2.6,0.9],[0.25,0.16,0.90],WOOD)
    cyl([2.9,2.6,1.95],0.14,0.22,[0.55,0.30,0.22,1])
    for i in range(5):
        vs=p.createVisualShape(p.GEOM_SPHERE,radius=0.11,rgbaColor=[0.20,0.55,0.25,1])
        p.createMultiBody(0,-1,vs,[2.9+random.uniform(-.12,.12),2.6+random.uniform(-.12,.12),2.15+i*0.07])
    cyl([-2.9,2.7,0.55],0.02,1.10,GOLD)
    cyl([-2.9,2.7,1.20],0.16,0.24,[1,0.95,0.80,0.9])

    # ---- balloons ----
    cols=[[0.95,0.35,0.45,1],[0.35,0.65,0.95,1],[0.45,0.90,0.60,1],
          [0.98,0.85,0.35,1],[0.85,0.45,0.95,1],[1,0.62,0.30,1]]
    globals()["_balloons"]=[]
    for i in range(7):
        x=random.uniform(-2.0,2.0); y=random.uniform(-1.0,2.0); z=random.uniform(1.1,1.7)
        vs=p.createVisualShape(p.GEOM_SPHERE,radius=0.14,rgbaColor=cols[i%len(cols)])
        cs=p.createCollisionShape(p.GEOM_SPHERE,radius=0.14)
        bid=p.createMultiBody(0.02,cs,vs,[x,y,z])   # light physical balloon
        p.changeDynamics(bid,-1,linearDamping=2.2,angularDamping=2.2,restitution=0.8)
        _balloons.append({"id":bid,"x":x,"y":y,"z":z,
                          "vx":random.uniform(-.006,.006),"vy":random.uniform(-.006,.006),
                          "ph":random.uniform(0,6.3)})

def _float_balloons(p,t):
    """Balloons drift around the room."""
    import math
    for b in globals().get("_balloons",[]):
        try:
            pos,_=p.getBasePositionAndOrientation(b["id"])
            # buoyancy keeps it near target height, gentle drift, walls bounce
            fz=(b["z"]-pos[2])*0.30 + 0.02*math.sin(t*0.7+b["ph"])
            fx=b["vx"]*3 - (0.25 if pos[0]>2.4 else 0) + (0.25 if pos[0]<-2.4 else 0)
            fy=b["vy"]*3 - (0.25 if pos[1]>2.7 else 0) + (0.25 if pos[1]<-1.3 else 0)
            p.applyExternalForce(b["id"],-1,[fx,fy,fz+0.196],pos,p.WORLD_FRAME)
        except Exception: pass

def _screen_focus():
    """Look at the wall screen (session monitoring)."""
    if _pepper is None: return
    try:
        _pepper.setAngles(["HeadYaw","HeadPitch"],[0.0,-0.12],0.15)
    except Exception: pass

_speaking=False
_sm={"yaw":0.0,"pitch":0.0,"rs":1.4,"ls":1.4,"re":0.5,"le":-0.5}

def set_speaking(flag):
    global _speaking; _speaking=bool(flag)

def _lerp(a,b,f): return a+(b-a)*f

def hello_wave():
    """Big friendly wave at simulation start."""
    if _pepper is None: return
    def _h():
        try:
            time.sleep(1.0)
            _pepper.setAngles(["HeadYaw","HeadPitch"],[0.0,-0.1],0.6)
            for _ in range(4):
                _pepper.setAngles(["RShoulderPitch","RShoulderRoll","RElbowRoll"],
                                  [-1.35,-0.35,1.10],0.95); time.sleep(0.26)
                _pepper.setAngles(["RShoulderPitch","RShoulderRoll","RElbowRoll"],
                                  [-1.35,-0.95,0.45],0.95); time.sleep(0.26)
            _pepper.setAngles(["RShoulderPitch","RShoulderRoll","RElbowRoll"],
                              [1.4,-0.15,0.5],0.7)
        except Exception: pass
    threading.Thread(target=_h,daemon=True).start()

_speaking=False
_smooth={"yaw":0.0,"pitch":0.0,"rs":1.4,"ls":1.4,"re":0.5,"le":-0.5}

def set_speaking(flag):
    """Called by pepper_voice when speech starts/stops."""
    global _speaking; _speaking=bool(flag)

def _lerp(a,b,f): return a+(b-a)*f

import random as _rnd

# _PEPPER_BRIDGE_INJECTED
import threading as _thr
from flask import Flask, request, jsonify
from flask_cors import CORS

_action = {"name": None, "until": 0.0}
_bridge_app = Flask("pepper_bridge")
CORS(_bridge_app)

@_bridge_app.route("/pepper/status", methods=["GET"])
def _b_status():
    return jsonify({"ok": True, "speaking": globals().get("_speaking", False),
                     "action": _action["name"]})

@_bridge_app.route("/pepper/speak", methods=["POST"])
def _b_speak():
    d = request.get_json(force=True, silent=True) or {}
    globals()["_speaking"] = bool(d.get("on", False))
    return jsonify({"ok": True, "speaking": globals()["_speaking"]})

@_bridge_app.route("/pepper/wave", methods=["POST"])
def _b_wave():
    d = request.get_json(force=True, silent=True) or {}
    dur = float(d.get("duration", 2.2))
    _action["name"] = "wave"
    _action["until"] = _clock() + dur
    return jsonify({"ok": True})

@_bridge_app.route("/pepper/clap", methods=["POST"])
def _b_clap():
    d = request.get_json(force=True, silent=True) or {}
    dur = float(d.get("duration", 2.0))
    _action["name"] = "clap"
    _action["until"] = _clock() + dur
    return jsonify({"ok": True})

@_bridge_app.route("/pepper/look", methods=["POST"])
def _b_look():
    d = request.get_json(force=True, silent=True) or {}
    _gaze["yaw"]  = max(-1.5, min(1.5, float(d.get("yaw", 0.0))))
    _gaze["pitch"]= max(-0.45, min(0.35, float(d.get("pitch", 0.0))))
    _gaze["hold"] = float(d.get("hold", 2.5))
    _gaze["next_t"] = _clock() + _gaze["hold"]
    return jsonify({"ok": True})

def _clock():
    import time
    return time.time()

def _start_bridge_server(port=5055):
    def _run():
        _bridge_app.run(host="0.0.0.0", port=port, debug=False, use_reloader=False)
    t = _thr.Thread(target=_run, daemon=True)
    t.start()
    print(f"[pepper_bridge] API listening on http://0.0.0.0:{port}")


_gaze={"yaw":0.0,"pitch":0.0,"next_t":0.0,"hold":1.5}

def _pick_gaze_target(t):
    _gaze["yaw"]=_rnd.uniform(-1.1,1.1)
    _gaze["pitch"]=_rnd.uniform(-0.35,0.25)
    _gaze["hold"]=_rnd.uniform(1.2,3.2)
    _gaze["next_t"]=t+_gaze["hold"]

def _chase_balloon(t):
    """Pepper stays fixed in place. Lively idle: random look-around + head tracking + arm/hand animation."""
    import math
    if _pepper is None: return
    bs=globals().get("_balloons",[])
    try:
        pos=None
        if _action["name"] and t < _action["until"]:
            ph2 = t*7.0
            if _action["name"] == "wave":
                _sm["yaw"]=_lerp(_sm["yaw"], 0.35, 0.6)
                _sm["pitch"]=_lerp(_sm["pitch"], -0.05, 0.6)
                _sm["rs"]=_lerp(_sm["rs"], -0.9+0.5*math.sin(ph2), 0.75)
                _sm["ls"]=_lerp(_sm["ls"], 1.0, 0.6)
                _sm["re"]=_lerp(_sm["re"], 1.3+0.5*math.sin(ph2*1.3), 0.75)
                _sm["le"]=_lerp(_sm["le"], -0.4, 0.6)
                _pepper.setAngles(["HeadYaw","HeadPitch"],[_sm["yaw"],_sm["pitch"]],1.0)
                _pepper.setAngles(["RShoulderPitch","LShoulderPitch","RElbowRoll","LElbowRoll"],
                                  [_sm["rs"],_sm["ls"],_sm["re"],_sm["le"]],0.95)
                return
            if _action["name"] == "clap":
                _sm["yaw"]=_lerp(_sm["yaw"], 0.0, 0.6)
                _sm["pitch"]=_lerp(_sm["pitch"], 0.05, 0.6)
                cl=0.15*abs(math.sin(ph2*1.6))
                _sm["rs"]=_lerp(_sm["rs"], 0.55+cl, 0.8)
                _sm["ls"]=_lerp(_sm["ls"], 0.55+cl, 0.8)
                _sm["re"]=_lerp(_sm["re"], 1.55, 0.8)
                _sm["le"]=_lerp(_sm["le"], -1.55, 0.8)
                _pepper.setAngles(["HeadYaw","HeadPitch"],[_sm["yaw"],_sm["pitch"]],1.0)
                _pepper.setAngles(["RShoulderPitch","LShoulderPitch","RElbowRoll","LElbowRoll"],
                                  [_sm["rs"],_sm["ls"],_sm["re"],_sm["le"]],0.95)
                return
        elif _action["name"] and t >= _action["until"]:
            _action["name"] = None

        if bs:
            import pybullet as p
            best=None; bd=1e9
            for bb in bs:
                q,_=p.getBasePositionAndOrientation(bb["id"])
                d=q[0]**2+q[1]**2
                if d<bd: bd=d; best=q
            pos=best

        if pos is not None:
            dx,dy=pos[0],pos[1]
            tgt_yaw=max(-1.6,min(1.6,math.atan2(dx,max(0.4,dy))))
            tgt_pitch=max(-0.45,min(0.35,-(pos[2]-1.25)*0.45))
        elif _speaking:
            tgt_yaw=0.30*math.sin(t*0.7)
            tgt_pitch=0.08*math.sin(t*0.5)
        else:
            if t>=_gaze["next_t"]:
                _pick_gaze_target(t)
            tgt_yaw=_gaze["yaw"]
            tgt_pitch=_gaze["pitch"]

        amp  = 1.05 if _speaking else 0.55
        blend= 0.75 if _speaking else 0.45
        yaw_blend = 0.70 if (pos is not None or _speaking) else 0.12
        ph   = t*(11.0 if _speaking else 5.5)

        _sm["yaw"]  =_lerp(_sm["yaw"],  tgt_yaw,   yaw_blend)
        _sm["pitch"]=_lerp(_sm["pitch"],tgt_pitch, yaw_blend)

        idle_breathe = 0.0 if _speaking else 0.06*math.sin(t*0.9)
        _sm["rs"]=_lerp(_sm["rs"], 1.00-amp*abs(math.sin(ph))+idle_breathe,     blend)
        _sm["ls"]=_lerp(_sm["ls"], 1.00-amp*abs(math.cos(ph*0.9))+idle_breathe, blend)
        _sm["re"]=_lerp(_sm["re"], 0.40+amp*0.75*math.sin(ph*1.4), blend)
        _sm["le"]=_lerp(_sm["le"],-0.40-amp*0.75*math.cos(ph*1.4), blend)

        _pepper.setAngles(["HeadYaw","HeadPitch"],[_sm["yaw"],_sm["pitch"]],1.0)
        _pepper.setAngles(["RShoulderPitch","LShoulderPitch","RElbowRoll","LElbowRoll"],
                          [_sm["rs"],_sm["ls"],_sm["re"],_sm["le"]],0.95)
    except Exception: pass


def _track_balloon(t):
    """Pepper looks at the nearest balloon and reaches toward it."""
    import math
    if _pepper is None: return
    bs=globals().get("_balloons",[])
    if not bs: return
    b=bs[int(t*0.25)%len(bs)]
    try:
        yaw=max(-2.0,min(2.0,math.atan2(b["x"],max(0.3,b["y"]))))
        pitch=max(-0.6,min(0.4,-(b["z"]-1.2)*0.5))
        _pepper.setAngles(["HeadYaw","HeadPitch"],[yaw,pitch],0.25)
        if int(t)%7<3:
            side="R" if b["x"]>0 else "L"
            _pepper.setAngles([side+"ShoulderPitch",side+"ShoulderRoll"],
                              [-0.5,-0.3 if side=="R" else 0.3],0.3)
        else:
            _pepper.setAngles(["RShoulderPitch","LShoulderPitch"],[1.4,1.4],0.2)
    except Exception: pass

def run_pepper_sim():
    global _pepper,_sm
    try:
        from qibullet import SimulationManager
        _sm=SimulationManager()
        client=_sm.launchSimulation(gui=True)
        _pepper=_sm.spawnPepper(client, spawn_ground_plane=True)
        try:
            import pybullet as _p
            _build_room(_p)
        except Exception as e: print("[pepper] room error:", e)
        try: _pepper.goToPosture("Stand", 0.6)
        except Exception: pass
        print("[pepper] simulation ready")
        hello_wave()
        hello_wave()
        t=0.0
        _start_bridge_server(5055)

        while True:
            # gentle idle: subtle head + arm motion so he looks alive
            try:
                _chase_balloon(t)
            except Exception:
                pass
            try:
                import pybullet as _p
                _float_balloons(_p, t)
            except Exception: pass
            t+=0.05
            time.sleep(0.05)
    except Exception as e:
        print("[pepper] sim error:", e)

def wave():
    """Pepper waves — call on greeting / correct answer."""
    if _pepper is None: return
    def _w():
        try:
            for _ in range(3):
                _pepper.setAngles(["RShoulderPitch","RShoulderRoll","RElbowRoll"],
                                  [-0.6,-0.3,1.2],0.4); time.sleep(0.35)
