        if os.path.exists(path3):
            tex3=p.loadTexture(path3)
            vs3=p.createVisualShape(p.GEOM_BOX,halfExtents=[0.50,0.01,0.26],rgbaColor=[1,1,1,1])
            b3=p.createMultiBody(0,-1,vs3,[0,3.05,0.65])
            p.changeVisualShape(b3,-1,textureUniqueId=tex3)
    except Exception: pass

    # ---- decoration: pendant lights ----
    for lx in (-1.2,1.2):
        cyl([lx,1.5,2.35],0.01,0.50,[0.3,0.3,0.3,1])
        vs=p.createVisualShape(p.GEOM_SPHERE,radius=0.11,rgbaColor=[1,0.95,0.75,0.9])
        p.createMultiBody(0,-1,vs,[lx,1.5,2.05])

    # ---- shelf + plant + lamp ----
    box([2.9,2.6,0.9],[0.25,0.16,0.90],WOOD)
    cyl([2.9,2.6,1.95],0.14,0.22,[0.55,0.30,0.22,1])
    for i in range(5):
        vs=p.createVisualShape(p.GEOM_SPHERE,radius=0.11,rgbaColor=[0.20,0.55,0.25,1])
        p.createMultiBody(0,-1,vs,[2.9+random.uniform(-.12,.12),2.6+random.uniform(-.12,.12),2.15+i*0.07])
    cyl([-2.9,2.7,0.55],0.02,1.10,GOLD)
    cyl([-2.9,2.7,1.20],0.16,0.24,[1,0.95,0.80,0.9])

    # ---- balloons ----
    cols=[[0.95,0.35,0.45,1],[0.35,0.65,0.95,1],[0.45,0.90,0.60,1],
          [0.98,0.85,0.35,1],[0.85,0.45,0.95,1],[1,0.62,0.30,1]]
    globals()["_balloons"]=[]
    for i in range(7):
        x=random.uniform(-2.0,2.0); y=random.uniform(-1.0,2.0); z=random.uniform(1.1,1.7)
        vs=p.createVisualShape(p.GEOM_SPHERE,radius=0.14,rgbaColor=cols[i%len(cols)])
        cs=p.createCollisionShape(p.GEOM_SPHERE,radius=0.14)
        bid=p.createMultiBody(0.02,cs,vs,[x,y,z])   # light physical balloon
        p.changeDynamics(bid,-1,linearDamping=2.2,angularDamping=2.2,restitution=0.8)
        _balloons.append({"id":bid,"x":x,"y":y,"z":z,
                          "vx":random.uniform(-.006,.006),"vy":random.uniform(-.006,.006),
                          "ph":random.uniform(0,6.3)})

def _float_balloons(p,t):
    """Balloons drift around the room."""
    import math
    for b in globals().get("_balloons",[]):
        try:
            pos,_=p.getBasePositionAndOrientation(b["id"])
            # buoyancy keeps it near target height, gentle drift, walls bounce
            fz=(b["z"]-pos[2])*0.30 + 0.02*math.sin(t*0.7+b["ph"])
            fx=b["vx"]*3 - (0.25 if pos[0]>2.4 else 0) + (0.25 if pos[0]<-2.4 else 0)
            fy=b["vy"]*3 - (0.25 if pos[1]>2.7 else 0) + (0.25 if pos[1]<-1.3 else 0)
            p.applyExternalForce(b["id"],-1,[fx,fy,fz+0.196],pos,p.WORLD_FRAME)
        except Exception: pass

def _screen_focus():
    """Look at the wall screen (session monitoring)."""
    if _pepper is None: return
    try:
        _pepper.setAngles(["HeadYaw","HeadPitch"],[0.0,-0.12],0.15)
    except Exception: pass

def _chase_balloon(t):
    """Pepper stays fixed in place — rotates and reaches, never walks away."""
    import math
    if _pepper is None: return
    bs=globals().get("_balloons",[])
    if not bs: return
    b=bs[int(t*0.08)%len(bs)]
    try:
        import pybullet as p
        pos,_=p.getBasePositionAndOrientation(b["id"])
        rx,ry,rth=_pepper.getPosition()
        # hard leash: if he drifted at all, snap back to origin
        if math.hypot(rx,ry) > 0.25:
            _pepper.moveTo(0,0,0,frame=1,speed=0.4,_async=False)
            return
        dx,dy=pos[0]-rx,pos[1]-ry
        yaw=math.atan2(dy,dx)-math.pi/2
        # rotate in place only (tiny 2 cm steps max, no translation)
        _pepper.setAngles(["HeadYaw","HeadPitch"],
                          [max(-1.8,min(1.8,yaw)), max(-0.5,min(0.4,-(pos[2]-1.2)*0.5))],0.25)
        side="R" if dx>0 else "L"
        _pepper.setAngles([side+"ShoulderPitch",side+"ShoulderRoll",side+"ElbowRoll"],
                          [-0.8,-0.3 if side=="R" else 0.3,0.3],0.5)
    except Exception: pass

def _track_balloon(t):
    """Pepper looks at the nearest balloon and reaches toward it."""
    import math
    if _pepper is None: return
    bs=globals().get("_balloons",[])
    if not bs: return
    b=bs[int(t*0.25)%len(bs)]
    try:
        yaw=max(-2.0,min(2.0,math.atan2(b["x"],max(0.3,b["y"]))))
        pitch=max(-0.6,min(0.4,-(b["z"]-1.2)*0.5))
        _pepper.setAngles(["HeadYaw","HeadPitch"],[yaw,pitch],0.25)
        if int(t)%7<3:
            side="R" if b["x"]>0 else "L"
            _pepper.setAngles([side+"ShoulderPitch",side+"ShoulderRoll"],
                              [-0.5,-0.3 if side=="R" else 0.3],0.3)
        else:
            _pepper.setAngles(["RShoulderPitch","LShoulderPitch"],[1.4,1.4],0.2)
    except Exception: pass

def run_pepper_sim():
    global _pepper,_sm
    try:
        from qibullet import SimulationManager
        _sm=SimulationManager()
        client=_sm.launchSimulation(gui=True)
        _pepper=_sm.spawnPepper(client, spawn_ground_plane=True)
        try:
            import pybullet as _p
            _build_room(_p)
        except Exception as e: print("[pepper] room error:", e)
        try: _pepper.goToPosture("Stand", 0.6)
        except Exception: pass
        print("[pepper] simulation ready")
        hello_wave()
        hello_wave()
        t=0.0
        while True:
            # gentle idle: subtle head + arm motion so he looks alive
            try:
                _chase_balloon(t)
            except Exception:
                pass
            try:
                import pybullet as _p
                _float_balloons(_p, t)
            except Exception: pass
            t+=0.05
            time.sleep(0.05)
    except Exception as e:
        print("[pepper] sim error:", e)

def wave():
    """Pepper waves — call on greeting / correct answer."""
    if _pepper is None: return
    def _w():
        try:
            for _ in range(3):
                _pepper.setAngles(["RShoulderPitch","RShoulderRoll","RElbowRoll"],
                                  [-0.6,-0.3,1.2],0.4); time.sleep(0.35)
                _pepper.setAngles(["RShoulderPitch","RShoulderRoll","RElbowRoll"],
                                  [-0.6,-0.9,0.6],0.4); time.sleep(0.35)
            _pepper.setAngles(["RShoulderPitch","RShoulderRoll","RElbowRoll"],
                              [1.4,-0.1,0.5],0.3)
        except Exception: pass
    threading.Thread(target=_w,daemon=True).start()

def celebrate():
    """Both arms up — call on celebration."""
    if _pepper is None: return
    def _c():
        try:
            _pepper.setAngles(["RShoulderPitch","LShoulderPitch"],[-1.2,-1.2],0.5)
            time.sleep(1.2)
            _pepper.setAngles(["RShoulderPitch","LShoulderPitch"],[1.4,1.4],0.3)
        except Exception: pass
    threading.Thread(target=_c,daemon=True).start()

def watch_screen():
    """Pepper turns to the wall screen and observes the session."""
    if _pepper is None: return
    def _w():
        try:
            _pepper.setAngles(["HeadYaw","HeadPitch"],[0.0,-0.15],0.3)
            _pepper.setAngles(["RShoulderPitch","LShoulderPitch"],[1.45,1.45],0.2)
        except Exception: pass
    threading.Thread(target=_w,daemon=True).start()

def clap():
    """Pepper claps to reward the child."""
    if _pepper is None: return
    def _c():
        try:
            for _ in range(4):
                _pepper.setAngles(["RShoulderPitch","RShoulderRoll","LShoulderPitch","LShoulderRoll"],
                                  [0.3,-0.05,0.3,0.05],0.6); time.sleep(0.22)
                _pepper.setAngles(["RShoulderPitch","RShoulderRoll","LShoulderPitch","LShoulderRoll"],
                                  [0.3,-0.45,0.3,0.45],0.6); time.sleep(0.22)
            _pepper.setAngles(["RShoulderPitch","LShoulderPitch"],[1.4,1.4],0.3)
        except Exception: pass
    threading.Thread(target=_c,daemon=True).start()

def talk_gesture():
    """Natural hand movement while Pepper speaks."""
    if _pepper is None: return
    import random
    def _t():
        try:
            for _ in range(random.randint(2,4)):
                _pepper.setAngles(["RShoulderPitch","RElbowRoll","LShoulderPitch","LElbowRoll"],
                    [1.1+random.uniform(-0.3,0.3), 0.8+random.uniform(-0.3,0.3),
                     1.1+random.uniform(-0.3,0.3), -0.8+random.uniform(-0.3,0.3)], 0.25)
                time.sleep(0.5)
            _pepper.setAngles(["RShoulderPitch","RElbowRoll","LShoulderPitch","LElbowRoll"],
                              [1.4,0.5,1.4,-0.5],0.2)
        except Exception: pass
    threading.Thread(target=_t,daemon=True).start()

def roam():
    """Pepper moves around the room to show mobility."""
    if _pepper is None: return
    import random
    def _r():
        try:
            for _ in range(3):
                _pepper.moveTo(random.uniform(-0.8,0.8), random.uniform(-0.5,0.5),
                               random.uniform(-1.2,1.2), frame=2, speed=0.4, _async=False)
                time.sleep(0.4)
            _pepper.moveTo(0,0,0,frame=2,speed=0.4,_async=False)
        except Exception as e: print("[pepper] roam:", e)
    threading.Thread(target=_r,daemon=True).start()

def launch_pepper_thread():
    th=threading.Thread(target=run_pepper_sim,daemon=True)
    th.start(); return th

